# Kopie als .env.cloudflare speichern und ausfüllen (Anleitung: ../HOSTING.md).
# Diese Werte sind keine Passwörter, gehören aber nur auf deinen Rechner.

# Aus "npx wrangler d1 create schreibi"
SCHREIBI_D1_NAME=schreibi
SCHREIBI_D1_DATABASE_ID=

# Zero Trust → Einstellungen → Team-Domain, z. B. meine-familie.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Zero Trust → Access → Anwendungen → (deine App) → "Application Audience (AUD) Tag"
ACCESS_AUD=
